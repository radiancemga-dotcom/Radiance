# ===========================================================================
# Radiance Laser — Variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
# ---------------------------------------------------------------------------
# MODO DE DADOS
# Se as variáveis do Supabase abaixo NÃO estiverem preenchidas, o sistema roda
# automaticamente em MODO DEMO (dados em localStorage no navegador), permitindo
# navegar por todo o site sem backend. Para forçar o modo demo mesmo com
# credenciais preenchidas, use VITE_USE_MOCK=true.
# ===========================================================================
VITE_USE_MOCK=false

# --- Supabase ---------------------------------------------------------------
# Crie um projeto em https://supabase.com e copie em Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Pagamentos (Asaas) -----------------------------------------------------
# Ative o fluxo de cobrança no painel admin. Requer Supabase configurado e as
# Edge Functions asaas-create-charge / asaas-webhook publicadas com a secret
# ASAAS_API_KEY. Mantenha "false" enquanto não tiver a conta Asaas.
VITE_PAYMENTS_ENABLED=false

# --- Geolocalização ---------------------------------------------------------
# Provider de distância: "osm" (gratuito, sem chave) ou "google" (requer chave).
VITE_GEO_PROVIDER=osm
# Necessário apenas se VITE_GEO_PROVIDER=google
VITE_GOOGLE_MAPS_API_KEY=

# --- Empresa (usado como fallback antes de carregar settings do banco) ------
VITE_COMPANY_PHONE=(44) 99162-9494
VITE_COMPANY_WHATSAPP=5544991629494
VITE_COMPANY_EMAIL=radiancemga@gmail.com

# ===========================================================================
# Variáveis abaixo são usadas SOMENTE pelas Edge Functions do Supabase
# (configurar em Supabase > Edge Functions > Secrets, não no frontend).
# ===========================================================================
# RESEND_API_KEY=
# NOTIFICATION_FROM_EMAIL=Radiance Laser <contato@radiancelaser.com.br>
# ADMIN_NOTIFICATION_EMAIL=admin@radiancelaser.com.br
# ASAAS_API_KEY=
# ASAAS_ENV=sandbox
# ASAAS_WEBHOOK_TOKEN=
